# Ops Phoenix — non-secret defaults for systemd EnvironmentFile.
# Secrets (ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL, GH_TOKEN, GRAFANA_TOKEN)
# live in /etc/ops-phoenix/secret and /etc/ops-phoenix/{gh-token,grafana-token}
# with mode 0600. This file is intentionally NOT secret.

# Kill-switch: set to 1 to disable the agent entirely (next timer fire
# exits 0 without invoking python). See also /etc/ops-phoenix/disabled.
OPS_PHOENIX_DISABLED=0

# Keep the last N days of run logs. logrotate.d/ops-phoenix prunes to this.
OPS_PHOENIX_LOG_RETENTION_DAYS=30

# Dry-run: detect → analyze → issue, but skip PR + merge. Recommended
# true for the first 2 weeks of slice 1, then flip to false.
OPS_PHOENIX_DRY_RUN=true

# Path overrides (rarely needed — defaults match the spec).
OPS_PHOENIX_CONFIG=/etc/ops-phoenix/config.json
OPS_PHOENIX_LOCK=/var/lock/ops-phoenix.lock
OPS_PHOENIX_LOG_DIR=/var/log/ops-phoenix/runs
OPS_PHOENIX_HEARTBEAT=/var/lib/ops-phoenix/heartbeat.prom